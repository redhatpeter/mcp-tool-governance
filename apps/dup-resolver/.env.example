AOAI_ENDPOINT=https://common-open-ai2.openai.azure.com/
AOAI_API_VERSION=2024-10-21
AOAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

SEARCH_ENDPOINT=https://ai102srch193837986-mig.search.windows.net
SEARCH_INDEX=mcp-tool-fingerprints
# Leave SEARCH_KEY_FILE empty to use DefaultAzureCredential. Set to a path
# holding an admin key only if the service hasn't enabled RBAC auth.
SEARCH_KEY_FILE=/tmp/aisearch-key.txt

APIM_GATEWAY_BASE=https://apimopenai992.azure-api.net
APIM_KEY_FILE=/tmp/apim-master-key.txt
MCP_SERVERS=governed-mcp,messy-mcp

CLUSTER_THRESHOLD=0.88
EMBEDDING_DIMS=3072

# Canonical map (L2 -> L3 handoff). Leave COSMOS_ENDPOINT empty to skip
# the Cosmos write entirely (the rest of ingest still runs).
# COSMOS_ENDPOINT=https://cosmoslab826582.documents.azure.com:443/
# COSMOS_DATABASE=governance
# COSMOS_CONTAINER=mcp-canonical-map
# Auth: set COSMOS_KEY (env), or COSMOS_KEY_FILE (path to file with key),
# or leave both empty to fall back to DefaultAzureCredential (RBAC).
# COSMOS_KEY_FILE=/tmp/cosmos-key.txt

# Read tools from spec files rather than the live gateway. L3's tools/list
# filter hides duplicates using the canonical_map that ingest writes, so a
# gateway-sourced ingest sees a shrinking catalog (feedback loop).
MCP_SOURCE=openapi
OPENAPI_SPEC_DIR=../../apim/openapi
APIM_SUBSCRIPTION_ID=0028ca35-f331-410c-b0d8-f9ea74973a4d
APIM_RESOURCE_GROUP=rg_apim
APIM_SERVICE_NAME=apimopenai992
