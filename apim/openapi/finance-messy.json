    "info": {
        "title": "Finance API (messy \u2014 anti-pattern reference)",
        "description": "Deliberately badly-designed finance API used as a NEGATIVE control for the MCP Tool Governance PoC. Demonstrates the four failure modes: name collisions, semantic duplicates, schema overloads, and ungrouped generic verbs. NOT FOR PRODUCTION USE.",
        "version": "0.1.0"
    },
